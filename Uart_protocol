#include <Arduino.h>

#define BAUD_RATE 115200UL

/* ---------------------------------------------------------
   Qualification counters
   --------------------------------------------------------- */

volatile uint32_t rxBytes = 0;
volatile uint32_t txBytes = 0;

volatile uint32_t framingErrors = 0;
volatile uint32_t parityErrors = 0;
volatile uint32_t overrunErrors = 0;
volatile uint32_t noiseErrors = 0;

volatile uint32_t rxOverflow = 0;

bool dataMatch = true;
bool testStarted = false;

uint32_t cpuCycles = 0;
uint32_t testStartCycles = 0;
uint32_t testEndCycles = 0;


/* ---------------------------------------------------------
   DWT CPU cycle counter
   --------------------------------------------------------- */

void startCycleCounter()
{
  CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;

  DWT->CYCCNT = 0;

  DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
}


/* ---------------------------------------------------------
   UART error checking
   --------------------------------------------------------- */

void checkUartErrors()
{
  uint32_t status = USART1->SR;

  if (status & USART_SR_FE)
    framingErrors++;

  if (status & USART_SR_PE)
    parityErrors++;

  if (status & USART_SR_ORE)
    overrunErrors++;

  if (status & USART_SR_NE)
    noiseErrors++;
}


/* ---------------------------------------------------------
   Reset qualification test
   --------------------------------------------------------- */

void resetTest()
{
  rxBytes = 0;
  txBytes = 0;

  framingErrors = 0;
  parityErrors = 0;
  overrunErrors = 0;
  noiseErrors = 0;

  rxOverflow = 0;

  dataMatch = true;
  testStarted = false;

  cpuCycles = 0;
  testStartCycles = 0;
  testEndCycles = 0;
}


/* ---------------------------------------------------------
   Process UART data
   --------------------------------------------------------- */

void runTest()
{
  while (Serial1.available() > 0)
  {
    uint8_t received = Serial1.read();

    /* Start timing with first received byte */
    if (!testStarted)
    {
      testStarted = true;

      testStartCycles = DWT->CYCCNT;
    }

    uint32_t cpuStart = DWT->CYCCNT;

    rxBytes++;

    /*
       Application-level echo.
       Serial1 itself is interrupt-driven and
       uses the STM32 core's UART ring buffers.
    */
    size_t written = Serial1.write(received);

    if (written != 1)
    {
      dataMatch = false;
      rxOverflow++;
    }

    cpuCycles += DWT->CYCCNT - cpuStart;

    /*
       ENTER finishes the current test.
    */
    if (received == '\n')
    {
      Serial1.flush();

      testEndCycles = DWT->CYCCNT;

      uint32_t testCycles =
          testEndCycles - testStartCycles;

      if (testCycles == 0)
        testCycles = 1;

      float testTimeSeconds =
          (float)testCycles /
          (float)SystemCoreClock;

      /*
         TX count is the same number of bytes
         successfully passed to Serial1.
      */
      txBytes = rxBytes - rxOverflow;

      float throughput =
          (float)txBytes /
          testTimeSeconds;

      uint32_t cpuLoad =
          (uint32_t)
          (((uint64_t)cpuCycles * 100ULL) /
           testCycles);

      if (cpuLoad > 100)
        cpuLoad = 100;

      Serial1.println();
      Serial1.println("===== UART QUALIFICATION RESULT =====");

      Serial1.print("RX BYTES: ");
      Serial1.println(rxBytes);

      Serial1.print("TX BYTES: ");
      Serial1.println(txBytes);

      if (dataMatch && rxBytes == txBytes)
        Serial1.println("DATA MATCH: PASS");
      else
        Serial1.println("DATA MATCH: FAIL");

      if (rxBytes == txBytes && rxOverflow == 0)
        Serial1.println("NO DATA LOSS: PASS");
      else
        Serial1.println("NO DATA LOSS: FAIL");

      Serial1.println();

      Serial1.print("FRAMING ERRORS: ");
      Serial1.println(framingErrors);

      Serial1.print("PARITY ERRORS: ");
      Serial1.println(parityErrors);

      Serial1.print("OVERRUN ERRORS: ");
      Serial1.println(overrunErrors);

      Serial1.print("NOISE ERRORS: ");
      Serial1.println(noiseErrors);

      Serial1.print("BUFFER OVERFLOW: ");
      Serial1.println(rxOverflow);

      Serial1.println();

      Serial1.print("THROUGHPUT: ");
      Serial1.print(throughput, 1);
      Serial1.println(" bytes/s");

      Serial1.print("CPU LOAD: ");
      Serial1.print(cpuLoad);
      Serial1.println(" %");

      Serial1.println();

      if (dataMatch &&
          rxBytes == txBytes &&
          rxOverflow == 0 &&
          framingErrors == 0 &&
          parityErrors == 0 &&
          overrunErrors == 0 &&
          noiseErrors == 0)
      {
        Serial1.println("STRESS TEST: PASS");
      }
      else
      {
        Serial1.println("STRESS TEST: FAIL");
      }

      Serial1.println();
      Serial1.println("READY FOR NEXT TEST");
      Serial1.println();

      Serial1.flush();

      resetTest();
    }
  }
}


/* ---------------------------------------------------------
   SETUP
   --------------------------------------------------------- */

void setup()
{
  /*
     USART1
     PA9  = TX
     PA10 = RX

     115200 baud
     8 data bits
     No parity
     1 stop bit
  */
  Serial1.begin(BAUD_RATE, SERIAL_8N1);

  startCycleCounter();

  delay(100);

  Serial1.println();
  Serial1.println("UART QUALIFICATION STARTED");
  Serial1.println("STM32F401CCU6");
  Serial1.println("USART1 - 115200 8N1");
  Serial1.println("ISR + RING BUFFER + ERROR HANDLING");
  Serial1.println("STRESS + THROUGHPUT + CPU MEASUREMENT");
  Serial1.println();
  Serial1.println("Type data and press ENTER.");
  Serial1.println();
}


/* ---------------------------------------------------------
   LOOP
   --------------------------------------------------------- */

void loop()
{
  checkUartErrors();

  runTest();
}
